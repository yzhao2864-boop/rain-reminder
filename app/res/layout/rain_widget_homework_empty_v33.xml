<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
 <LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_height="match_parent" android:text="今日安排" android:textSize="16sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:layout_weight="1" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_refresh" android:layout_width="80dp" android:layout_height="48dp" android:text="刷新课表" android:textSize="11sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/widget_action" /><TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:text="⋯" android:textSize="24sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:contentDescription="显示方式菜单" />
  </LinearLayout>
  <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#61736B" android:fontFamily="@font/ui" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<LinearLayout android:id="@+id/widget_day_nav" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"><TextView android:id="@+id/widget_day_previous" android:layout_width="48dp" android:layout_height="match_parent" android:text="&lt;" android:textSize="22sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" /><TextView android:id="@+id/widget_day_title" android:layout_width="0dp" android:layout_height="match_parent" android:text="" android:textSize="12sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_day_today" android:layout_width="52dp" android:layout_height="match_parent" android:text="今天" android:textSize="12sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" /><TextView android:id="@+id/widget_day_next" android:layout_width="48dp" android:layout_height="match_parent" android:text="&gt;" android:textSize="22sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" /></LinearLayout>
  <ImageView android:id="@+id/widget_week_header" android:layout_width="match_parent" android:layout_height="38dp" android:scaleType="fitXY" android:visibility="gone" android:contentDescription="一周日期栏" />
  <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" />
  <ListView android:id="@+id/widget_primary_list" android:layout_width="match_parent" android:layout_height="48dp" android:layout_weight="0" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="vertical" android:visibility="gone" />
  <ListView android:id="@+id/widget_day_pages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" android:visibility="gone" />
  <ImageView android:id="@+id/widget_day_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:visibility="gone" />
<LinearLayout android:id="@+id/widget_secondary_nav" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"><TextView android:id="@+id/widget_secondary_nav_previous" android:layout_width="48dp" android:layout_height="match_parent" android:text="&lt;" android:textSize="22sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" /><TextView android:id="@+id/widget_secondary_nav_title" android:layout_width="0dp" android:layout_height="match_parent" android:text="" android:textSize="12sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_secondary_nav_today" android:layout_width="52dp" android:layout_height="match_parent" android:text="今天" android:textSize="12sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" /><TextView android:id="@+id/widget_secondary_nav_next" android:layout_width="48dp" android:layout_height="match_parent" android:text="&gt;" android:textSize="22sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="6dp" android:layout_weight="1">
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical"><LinearLayout android:id="@+id/widget_homework_area" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp">
    <TextView android:id="@+id/widget_homework" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_homework_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#61736B" android:fontFamily="@font/ui" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
<TextView android:id="@+id/widget_check_homework" android:layout_width="80dp" android:layout_height="48dp" android:text="刷新作业" android:textSize="11sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/widget_action" />
  </LinearLayout><ListView android:id="@+id/widget_secondary_list" android:layout_width="match_parent" android:layout_height="0dp" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="vertical" android:visibility="gone" android:layout_weight="1" />
   </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_menu" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background" android:visibility="gone">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/widget_menu_title" android:layout_width="0dp" android:layout_height="match_parent" android:text="显示方式" android:textSize="16sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:layout_weight="1" android:textStyle="bold" /><TextView android:id="@+id/widget_menu_close" android:layout_width="48dp" android:layout_height="48dp" android:text="×" android:textSize="24sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" android:contentDescription="关闭显示方式菜单" />
  </LinearLayout>
  <ListView android:id="@+id/widget_menu_options" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="vertical" />
<TextView android:id="@+id/widget_more_settings" android:layout_width="match_parent" android:layout_height="44dp" android:text="更多设置" android:textSize="12sp" android:textColor="#215C52" android:fontFamily="@font/ui" android:includeFontPadding="false" android:gravity="center" />
 </LinearLayout>
</FrameLayout>