<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_course_area" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="7dp" android:layout_marginBottom="4dp" android:background="@drawable/widget_row_background">
 <TextView android:id="@+id/widget_course_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节课程" android:textSize="13sp" android:textColor="#233F34" android:textStyle="bold" android:fontFamily="@font/ui" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_course_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="时间 · 教室" android:textSize="10sp" android:textColor="#53675E" android:fontFamily="@font/ui" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
